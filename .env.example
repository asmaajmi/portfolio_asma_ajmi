# Copy to .env (never commit .env) and fill in your values.

# Required for the AI chatbot. Without it the chat falls back to short offline answers.
ANTHROPIC_API_KEY=

# Optional — defaults shown.
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth / cost: low | medium | high
ANTHROPIC_EFFORT=low
# Server-side refusal fallbacks (Claude API only). Set to "off" for models/platforms that do not support them.
ANTHROPIC_FALLBACKS=default

PORT=5173
# Use 0.0.0.0 when running in a container / behind a reverse proxy.
HOST=127.0.0.1

# Abuse protection for /api/chat (per client IP).
CHAT_RATE_LIMIT_PER_MINUTE=8
CHAT_RATE_LIMIT_PER_DAY=100
# Comma-separated list of origins allowed to call /api/chat (empty = any origin).
ALLOWED_ORIGINS=
# Set to 1 only behind a trusted reverse proxy, so X-Forwarded-For is used as the client IP.
TRUST_PROXY=0
